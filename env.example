# Скопируйте в .env и отредактируйте значения:
#   copy env.example .env

# Обязательно
RAG_ADMIN_TOKEN=change-me-to-a-long-random-token

# tmux/non-interactive shell: активируйте venv напрямую (надёжнее чем RAG_USE_UV)
RAG_VENV=~/.venv
# RAG_USE_UV=true   # только если uv всегда в PATH (tmux часто без PATH)
# RAG_CONDA_ENV=vurdalaque

# Server
RAG_HOST=0.0.0.0
RAG_PORT=8000

# Embedding API (должен совпадать с моделью индекса)
EMBEDDING_URL=http://192.168.10.250:8002/v1/embeddings
EMBEDDING_MODEL=qwen3-embedding

# Каталоги runtime (создаются автоматически)
RAG_STAGING_DIR=./data/staging
RAG_BUNDLE_STATE_DIR=./data/state

# Опционально: fallback-индекс до первого deploy
# RAG_INDEX_FILE=../rag_crawler/rag_index.faiss
# RAG_METADATA_FILE=../rag_crawler/rag_metadata.jsonl

# Опционально: rerank (выключен по умолчанию), LLM, web search
# RAG_RERANK_ENABLED=true
# RERANK_URL=http://127.0.0.1:8002/v1/rerank
# LLM (Qwen3.8-27B non-thinking defaults applied when client omits params)
# LLM_URL=http://127.0.0.1:8001/v1/chat/completions
# LLM_MODEL=Qwen3.8-27B
# RAG_LLM_TEMPERATURE=0.7
# RAG_LLM_TOP_P=0.8
# RAG_LLM_TOP_K=20
# RAG_LLM_PRESENCE_PENALTY=1.5
# RAG_LLM_REPETITION_PENALTY=1.0
# RAG_LLM_ENABLE_THINKING=false
# RAG_LLM_FORCE_DEFAULTS=false
# SEARXNG_URL=http://127.0.0.1:8003/search
# RAG_SOURCE_TYPE_BOOSTS={"documentation": 1.2}

# Recency decay for documents with updated_at metadata (e.g. Confluence dump)
# RAG_RECENCY_ENABLED=true
# RAG_RECENCY_HALFLIFE_DAYS=365
# RAG_RECENCY_MIN_FACTOR=0.25

# Chat completions: rag_use_system_prompt (default true) is a request-body flag,
# not an env var. Set it per request to skip the built-in RAG system prompt while
# still injecting retrieved context. See README.md for details.

# Metrics (VictoriaMetrics scrape)
# RAG_METRICS_ENABLED=true
# RAG_METRICS_PATH=/metrics
# RAG_METRICS_PROBE_ENABLED=true
# RAG_METRICS_PROBE_INTERVAL=30

# Image generation (ComfyUI) — MCP tools register only after successful startup probe
# IMAGE_GENERATION_ENABLED=false
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_OUTPUT_ROOT=/path/to/ComfyUI/output
# COMFYUI_WORKFLOW_TEMPLATE=./data/comfy_image_workflow.template.json
# IMAGE_GENERATION_PROBE_TIMEOUT=15
# IMAGE_GENERATION_TIMEOUT=600
# IMAGE_GENERATION_OUTPUT_READ_TIMEOUT=120
# IMAGE_GENERATION_UPLOAD_TIMEOUT=120
# MCP clients (ChatGPT Connector, some proxies) may drop tools/call near 60s — see docs/mcp.md
# IMAGE_GENERATION_MAX_IMAGES=4
# IMAGE_GENERATION_MAX_OUTPUT_BYTES=20971520
# IMAGE_GENERATION_MAX_REFERENCE_IMAGES=8
# IMAGE_GENERATION_MAX_REFERENCE_BYTES=10485760
# IMAGE_GENERATION_DEFAULT_RESOLUTION=1024
# IMAGE_GENERATION_DEFAULT_STEPS=25
# IMAGE_GENERATION_DEFAULT_CFG=1.0
# IMAGE_GENERATION_DEFAULT_SAMPLER=euler
# IMAGE_GENERATION_DEFAULT_SCHEDULER=simple
# IMAGE_GENERATION_SAFETY_ENABLED=false

# Image analysis (multimodal LLM — uses LLM_URL, not Qwen Image)
# IMAGE_ANALYSIS_ENABLED=true
# IMAGE_ANALYSIS_MAX_IMAGES=10
# IMAGE_ANALYSIS_MAX_BYTES=10485760
# IMAGE_ANALYSIS_TIMEOUT=120
# IMAGE_ANALYSIS_PROBE_TIMEOUT=15
# IMAGE_ANALYSIS_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp

# Image segmentation (ComfyUI: Grounding DINO + Kijai SAM2 — same COMFYUI_URL as generation)
# IMAGE_SEGMENTATION_ENABLED=true
# IMAGE_GROUNDING_THRESHOLD=0.3
# IMAGE_GROUNDING_MODEL_NAME=GroundingDINO: SwinT OGC
# IMAGE_SAM2_MODEL=sam2_hiera_small.safetensors
# IMAGE_SAM2_PRECISION=bf16
# IMAGE_SEGMENTATION_MAX_BYTES=10485760
# IMAGE_SEGMENTATION_MAX_DIMENSION=8192
# IMAGE_SEGMENTATION_TIMEOUT=600

# Image upscale (ComfyUI RealESRGAN_x4plus — not Lanczos resize)
# IMAGE_UPSCALE_ENABLED=false
# IMAGE_UPSCALE_COMFY_MODEL=RealESRGAN_x4plus.pth
# IMAGE_UPSCALE_DEFAULT_SCALE=4
# IMAGE_COMFY_MAX_CONCURRENT=4
# IMAGE_VLM_MAX_CONCURRENT=8
# IMAGE_UPSCALE_DEFAULT_SCALE=2.0
# IMAGE_UPSCALE_MAX_SCALE=4.0
# IMAGE_UPSCALE_MIN_SCALE=1.01
# IMAGE_UPSCALE_MAX_INPUT_BYTES=10485760
# IMAGE_UPSCALE_MAX_OUTPUT_BYTES=20971520
# IMAGE_UPSCALE_MAX_INPUT_DIMENSION=4096
# IMAGE_UPSCALE_MAX_OUTPUT_DIMENSION=8192
# IMAGE_UPSCALE_TIMEOUT=300
# IMAGE_UPSCALE_PROBE_TIMEOUT=15
